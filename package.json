{
  "name": "blacknote",
  "description": "Notion-like note-taking Chrome extension with AI",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
